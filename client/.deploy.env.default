# ==========================================================
# 원격 서버 접속 정보 기본 템플릿 (.deploy.env.default)
# 실제 배포 시 이 파일을 복사하여 .deploy.env로 생성하고 정보를 입력하세요.
# ==========================================================
REMOTE_PROTO="sftp"            # sftp 또는 ftp
REMOTE_HOST="123.45.67.89"     # 원격 서버 IP 또는 도메인
REMOTE_PORT="22"               # SFTP는 22, FTP는 21
REMOTE_USER="username"         # 접속 계정 아이디
REMOTE_PASS="password"         # 접속 비밀번호
REMOTE_DIR="/var/www/html/lookup"  # 원격 서버 업로드 대상 경로
